# Create a .env file beside this file and add your own API key. Never commit it.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: choose a different compatible model or an OpenAI-compatible endpoint.
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com

# MySQL database used for schema discovery and selected-query execution.
# Create a least-privilege account; use a read-only account until write execution is needed.
TARGET_DATABASE_URL=mysql://username:password@localhost:3306/database_name
